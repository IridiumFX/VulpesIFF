/* VulpesIFF — `now` workspace root, beside the CMake build.
 *
 * The root holds no build of its own. It lists the submodule IFF needs and
 * the iff/ module, whose manifest points at the existing layout (src/,
 * include/IFF/, Codecs/), so the sources do not move. Build and test from
 * this directory: `now build`, `now test`.
 *
 *   dependencies/VulpesCore   submodule, artifact vulpes-core
 *   iff/                      artifact vulpes-iff
 *
 * A workspace that uses IFF lists "../VulpesIFF/iff" beside its own copy
 * of Core, so it links one Core, not this submodule's as well.
 */
{
  group:    "dev.iridium",
  artifact: "vulpes-iff-workspace",
  version:  "1.0.0",
  description: "VulpesIFF workspace: IFF-2025 reference reader/writer with ILBM + SVX8 codecs",
  license:  "MIT",
  langs:    ["c"],
  std:      "c23",

  /* The root must compile nothing itself. Without this, `now build` here
   * falls back to the default src/main/c, which is iff/'s source tree,
   * and compiles it a second time without iff/'s settings. iff/ holds no
   * .c, so pointing the root at it leaves the root empty. */
  sources: { dir: "iff" },

  modules: [
    "dependencies/VulpesCore",
    "iff"
  ]
}
